{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XIII NRV Meter",
  "version": "2.0.79",
  "identifier": "gg.xiiinrv.meter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XIII NRV Meter",
        "width": 400,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "resources": [
      "../src/data"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "skip"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libpcap0.8t64 | libpcap0.8",
          "libcap2-bin"
        ],
        "postInstallScript": "../packaging/linux/postinst.sh"
      }
    },
    "publisher": "XIII NRV",
    "copyright": "© taengu — A2Tools DPS Meter. © 2026 XIII NRV — version modifiée. Sous licence GPL-3.0.",
    "shortDescription": "Meter de combat AION 2 de la guilde XIII NRV",
    "longDescription": "Version modifiée d'A2Tools DPS Meter (GPL-3.0) pour la guilde XIII NRV. Lit le trafic du jeu avec Npcap pour afficher les dégâts, les soins et le déroulé des combats, et peut envoyer la fiche du personnage au site de la guilde quand le membre fournit son jeton. Npcap doit être installé séparément.",
    "licenseFile": "../LICENSE"
  }
}
